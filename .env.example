# Copy to .env and set the values for the PostgreSQL instance used by OLTP scripts.
# Docker Compose reads POSTGRES_USER/PASSWORD/DB/PORT; the Python scripts also
# read POSTGRES_HOST and TLS settings. Never commit the completed .env file.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=replace-with-postgres-password
POSTGRES_DB=ecommerce
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
POSTGRES_SSLMODE=prefer
# On EC2, set POSTGRES_HOST to the private RDS endpoint, set
# POSTGRES_SSLMODE=verify-full, and set POSTGRES_SSLROOTCERT to the absolute
# path of the downloaded RDS CA bundle. Use the RDS database username/password.
# POSTGRES_SSLROOTCERT=/home/ubuntu/global-bundle.pem
AWS_REGION=ap-southeast-1
# S3_BUCKET=your-project-bucket
# Optional on a local machine with an AWS CLI profile; leave unset on EC2 to use its instance role.
# AWS_PROFILE=ecommerce-cdc-test-sdk
# Alternatively, put both keys in the ignored .env for local runs; these take priority over AWS_PROFILE.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials; omit for an IAM user access key.
# AWS_SESSION_TOKEN=
AIRFLOW_PORT=8080
# Airflow runs in Docker; use host.docker.internal for local PostgreSQL or the RDS private endpoint.
AIRFLOW_POSTGRES_HOST=host.docker.internal
# AIRFLOW_POSTGRES_PORT=5432
# AIRFLOW_POSTGRES_DB=ecommerce_1c_test
# Required for Stage 6: the bucket covered by the Databricks external location.
# Keeps the existing S3_BUCKET for other local/test commands unchanged.
# AIRFLOW_S3_BUCKET=your-project-bucket
# Set these in the ignored .env before enabling the daily DAG; never commit the token/webhook URL.
# DBT_DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
# DBT_CATALOG=ecommerce_cdc
# DBT_SILVER_SCHEMA=silver
# DBT_TARGET_SCHEMA=analytics_dev
# DATABRICKS_TOKEN=
# AIRFLOW_ALERT_WEBHOOK_URL=
# Set all three together for an isolated 1C run; use the same project bucket but separate keys/schemas.
# PIPELINE_S3_PREFIX=stage6_1c_test
# DBT_SILVER_SCHEMA=silver_validation_1c
# DBT_TARGET_SCHEMA=validation_1c
