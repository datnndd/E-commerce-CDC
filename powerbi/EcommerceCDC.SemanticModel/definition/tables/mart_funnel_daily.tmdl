table mart_funnel_daily
	lineageTag: c7b24f25-d247-4297-8150-97770ea8607b

	measure Sessions = SUM(mart_funnel_daily[session_count])
		formatString: #,##0
		lineageTag: 13a7eb05-8e98-4be5-8f17-2ab9d8ba5e66

	measure 'View sessions' = SUM(mart_funnel_daily[view_sessions])
		formatString: #,##0
		lineageTag: a5c648e2-879a-4031-a3fa-09ec80242a22

	measure 'Cart sessions' = SUM(mart_funnel_daily[cart_sessions])
		formatString: #,##0
		lineageTag: 322d821e-087c-4b9c-bde4-4f1e1813b1bf

	measure 'Checkout sessions' = SUM(mart_funnel_daily[checkout_sessions])
		formatString: #,##0
		lineageTag: 7a733e49-4f69-4a2a-a5f3-923864eaf8cb

	measure 'Purchase sessions' = SUM(mart_funnel_daily[purchase_sessions])
		formatString: #,##0
		lineageTag: c5bc7544-5c1c-4766-af54-b76d243fa843

	measure 'Purchase rate' = DIVIDE([Purchase sessions],[Sessions])
		formatString: 0.0%
		lineageTag: b3814893-2374-4d7e-b503-d01ca468fda8

