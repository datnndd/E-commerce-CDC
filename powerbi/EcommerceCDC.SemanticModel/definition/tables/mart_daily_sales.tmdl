table mart_daily_sales
	lineageTag: df86e3e4-1fa1-4744-af03-8a16dc9ea55c

	measure 'Delivered item revenue' = SUM(mart_daily_sales[delivered_item_revenue_brl])
		formatString: #,##0.00
		lineageTag: 753402b8-d30d-45ea-ae5c-9fa980b25efb

	measure Orders = SUM(mart_daily_sales[order_count])
		formatString: #,##0
		lineageTag: d965ec7d-003d-413c-a248-073e5884cc32

	measure 'Delivered orders' = SUM(mart_daily_sales[delivered_order_count])
		formatString: #,##0
		lineageTag: b2904db7-1ebc-41c0-a0c8-28ed8872f50b

	measure 'AOV delivered item' = DIVIDE([Delivered item revenue],[Delivered orders])
		formatString: #,##0.00
		lineageTag: a8ad35a8-83ac-405e-8dd1-03df3594adb1

	measure 'Cancellation rate' = DIVIDE(SUM(mart_daily_sales[canceled_order_count]),[Orders])
		formatString: 0.0%
		lineageTag: 14be6c11-ba32-4e18-818b-f00bb7ebfc18

