table mart_order_experience_daily
	lineageTag: 67d529b7-e2d9-4fc6-9048-e62b28672259

	measure 'Experience delivered orders' = SUM(mart_order_experience_daily[delivered_order_count])
		formatString: #,##0
		lineageTag: ac5c95f7-c4aa-4717-aa83-f685fbea1059

	measure 'Late rate' = DIVIDE(SUM(mart_order_experience_daily[late_delivery_order_count]),SUM(mart_order_experience_daily[orders_with_delivery_date]))
		formatString: 0.0%
		lineageTag: 6c596405-45ce-42cf-9b5a-a93cbd077a68

	measure 'Delivery days' = DIVIDE(SUMX(mart_order_experience_daily,mart_order_experience_daily[average_delivery_days]*mart_order_experience_daily[orders_with_delivery_date]),SUM(mart_order_experience_daily[orders_with_delivery_date]))
		formatString: 0.0
		lineageTag: 249c1d04-bb29-4d92-b201-7b740611ac34

	measure 'Review score' = DIVIDE(SUMX(mart_order_experience_daily,mart_order_experience_daily[average_order_review_score]*mart_order_experience_daily[reviewed_order_count]),SUM(mart_order_experience_daily[reviewed_order_count]))
		formatString: 0.00
		lineageTag: 83246093-f29c-4092-9385-4654b222a8f2

