model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: vi-VN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["MCP-PBIModeling"]

ref table mart_daily_sales
ref table mart_product_performance
ref table mart_customer_rfm
ref table mart_payment_mix_daily
ref table mart_order_experience_daily
ref table mart_funnel_daily
ref table ops_pipeline_runs

ref cultureInfo en-US
