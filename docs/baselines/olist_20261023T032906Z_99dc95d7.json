    "canceled_order_rate": {
      "definition": "Raw Olist status 'canceled' divided by all orders; 'unavailable' is separate.",
      "unit": "percent of orders",
      "sql": "\n            SELECT count(*) FILTER (WHERE order_status = 'canceled') AS canceled_orders,\n                   count(*) AS all_orders,\n                   round(100.0 * count(*) FILTER (WHERE order_status = 'canceled') / nullif(count(*), 0), 4) AS canceled_percent\n            FROM orders\n        ",
      "rows": [
